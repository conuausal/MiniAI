# ===== 应用配置 =====
APP_NAME=MiniAI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-string

# ===== 数据库（默认 MySQL，docker compose up -d mysql 即可）=====
# 注意：宿主 3306 可能被本机原生 MySQL 占用，docker-compose 把容器映射到 3307
DATABASE_URL=mysql+aiomysql://miniai:miniai@localhost:3307/miniai
# 若用 SQLite 本地调试可改为：
# DATABASE_URL=sqlite+aiosqlite:///./data/miniai.db

# ===== 向量库 =====
VECTOR_STORE_DIR=./data/vector_store
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== Redis 对话记忆窗口（docker compose up -d redis）=====
REDIS_URL=redis://localhost:6379/0
MEMORY_WINDOW_ROUNDS=20

# ===== RAG 重排序（首次查询会下载模型）=====
# 默认 BAAI/bge-reranker-v2-m3（多语言、国内镜像可达）；想用 GTE 系列改为：
# RERANK_MODEL=Alibaba-NLP/gte-rerank-v2-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 国内访问 HuggingFace 慢/被墙时启用镜像：
HF_ENDPOINT=https://hf-mirror.com

# ===== 随机二次元 =====
RANDOM_ANIME_API=https://api.elaina.cat/random/

# ===== 多 provider API Keys（用户也可在前端 🔑 配置） =====
# 不填也没关系，用户可以自己在网页上填 Key。

# 🐋 DeepSeek（推荐，性价比高 + 中文强）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 🧠 OpenAI（GPT-4o / o1 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 🤖 MiniMax（M3 / Text-01）
MiniMax_API_KEY=
MiniMax_BASE_URL=https://api.MiniMax.chat/v1

# 🀄 智谱 GLM（GLM-4-Plus / Flash 有免费额度）
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 🌙 Moonshot Kimi（128K 长上下文）
MOONSHOT_API_KEY=

# ☁️ 通义千问 Qwen（阿里 DashScope 兼容模式）
QWEN_API_KEY=

# 💎 Google Gemini（OpenAI 兼容端点）
GEMINI_API_KEY=

# ===== 联网搜索（阿里云百炼 DashScope Web Search，与 qwen 共用同一个 key）=====
DASHSCOPE_API_KEY=
# 未配置 DashScope 时才回退到 Tavily：
TAVILY_API_KEY=
